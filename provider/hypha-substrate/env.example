# hypha-substrate env file — copy to ~/.config/hypha-substrate/env and
# fill in. systemd EnvironmentFile does NOT expand $VARS or ~ — use
# absolute paths and literal values. Anything set here overrides the
# inline `env:` block in tamias.yaml (EnvironmentFile wins over
# Environment=).
#
# Names only below — this file carries values, keep it out of git
# (chmod 600). Secrets (tokens) belong here, never in tamias.yaml.

# Isolated hypha home — REQUIRED if any other hypha node/hub runs on
# this host: the default ~/.local/share/hypha holds node.json, the
# node identity file both daemons would share.
HYPHA_HOME=/home/YOU/.local/share/hypha-substrate

# Node auth — optional on the 127.0.0.1 bind above; REQUIRED before
# raising HYPHA_HOST off loopback.
# HYPHA_TOKEN=

# Hub client→hub gate — optional on loopback; REQUIRED for non-loopback.
# HYPHA_HUB_TOKEN=

# Hub→node bearer (only when the node sets HYPHA_TOKEN).
# HYPHA_NODE_TOKEN=

# Multi-node hub roster (`id=url[@token];…`) — wins over HYPHA_NODE_URL
# when set. The inline env already points at this provider's node.
# HYPHA_NODES=

# Credential store for hub-issued node credentials: auto|keyring|file.
# HYPHA_CREDENTIAL_STORE=auto

# Optional: CORS allowlist, display name overrides, push config,
# OTEL endpoint (HYPHA_OTEL_* / OTEL_EXPORTER_OTLP_*).
# HYPHA_ORIGINS=
# HYPHA_NAME=
# HYPHA_PUSH=
